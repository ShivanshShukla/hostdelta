[Unit]
Description=HostDelta host evidence collector
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=hostdelta
Group=hostdelta
StateDirectory=hostdelta
StateDirectoryMode=0700
Environment=HOSTDELTA_STATE_DIR=/var/lib/hostdelta
EnvironmentFile=-/etc/hostdelta/credentials.env
ExecStart=/usr/local/bin/hostdelta daemon --config /etc/hostdelta/config.json
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hostdelta
RestrictSUIDSGID=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
